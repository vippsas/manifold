{
  "base": "vs-dark",
  "inherit": true,
  "rules": [
    { "background": "06080F", "token": "" },
    { "foreground": "5E6B82", "token": "comment" },
    { "foreground": "5E6B82", "token": "punctuation.definition.comment" },
    { "foreground": "8FB4F2", "token": "string" },
    { "foreground": "7FC8E8", "token": "constant.numeric" },
    { "foreground": "E2C275", "token": "constant.language" },
    { "foreground": "7FC8E8", "token": "constant.character" },
    { "foreground": "43C97A", "token": "constant.other" },
    { "foreground": "D3DBE8", "token": "variable" },
    { "foreground": "D3DBE8", "token": "variable.other.readwrite.instance" },
    { "foreground": "E2C275", "fontStyle": "bold", "token": "keyword" },
    { "foreground": "E2C275", "fontStyle": "bold", "token": "storage" },
    { "foreground": "B8C2D6", "fontStyle": "italic", "token": "storage.type" },
    { "foreground": "8FB4F2", "fontStyle": "underline", "token": "entity.name.class" },
    { "foreground": "8FB4F2", "fontStyle": "italic underline", "token": "entity.other.inherited-class" },
    { "foreground": "E6ECF7", "token": "entity.name.function" },
    { "foreground": "D3DBE8", "fontStyle": "italic", "token": "variable.parameter" },
    { "foreground": "E2C275", "token": "entity.name.tag" },
    { "foreground": "B8C2D6", "token": "entity.other.attribute-name" },
    { "foreground": "E6ECF7", "token": "support.function" },
    { "foreground": "43C97A", "token": "support.constant" },
    { "foreground": "B8C2D6", "fontStyle": "italic", "token": "support.type" },
    { "foreground": "B8C2D6", "fontStyle": "italic", "token": "support.class" },
    { "foreground": "F0F4FB", "background": "7A2230", "token": "invalid" },
    { "foreground": "F0F4FB", "background": "3E4D6B", "token": "invalid.deprecated" },
    { "foreground": "8A95AB", "token": "meta.structure.dictionary.json string.quoted.double.json" },
    { "foreground": "5E6B82", "token": "meta.diff" },
    { "foreground": "5E6B82", "token": "meta.diff.header" },
    { "foreground": "D2495F", "token": "markup.deleted" },
    { "foreground": "43C97A", "token": "markup.inserted" },
    { "foreground": "E2C275", "token": "markup.changed" },
    { "foreground": "7FC8E8", "token": "constant.numeric.line-number.find-in-files - match" },
    { "foreground": "E2C275", "token": "entity.name.filename" },
    { "foreground": "D2495F", "token": "message.error" },
    { "foreground": "E2C275", "fontStyle": "bold", "token": "markup.heading.markdown" },
    { "foreground": "E2C275", "fontStyle": "bold", "token": "markup.heading.1.markdown" },
    { "foreground": "E2C275", "fontStyle": "bold", "token": "markup.heading.2.markdown" },
    { "foreground": "E2C275", "fontStyle": "bold", "token": "markup.heading.3.markdown" },
    { "foreground": "E2C275", "fontStyle": "bold", "token": "markup.heading.4.markdown" },
    { "foreground": "E2C275", "fontStyle": "bold", "token": "markup.heading.5.markdown" },
    { "foreground": "E2C275", "fontStyle": "bold", "token": "markup.heading.6.markdown" },
    { "foreground": "E6ECF7", "fontStyle": "bold", "token": "markup.bold.markdown" },
    { "foreground": "B8C2D6", "fontStyle": "italic", "token": "markup.italic.markdown" },
    { "foreground": "E2C275", "token": "punctuation.definition.metadata.markdown" },
    { "foreground": "E6ECF7", "token": "punctuation.definition.bold.markdown" },
    { "foreground": "B8C2D6", "token": "punctuation.definition.italic.markdown" },
    { "foreground": "8A95AB", "token": "markup.inline.raw.markdown" },
    { "foreground": "8A95AB", "token": "markup.raw.inline.markdown" },
    { "foreground": "8A95AB", "token": "markup.raw.block.markdown" },
    { "foreground": "8A95AB", "token": "punctuation.definition.raw.markdown" },
    { "foreground": "E2C275", "token": "markup.underline.link.markdown" },
    { "foreground": "E2C275", "token": "markup.underline.link.image.markdown" },
    { "foreground": "E2C275", "token": "string.other.link.title.markdown" },
    { "foreground": "E6ECF7", "token": "string.other.link.description.markdown" },
    { "foreground": "8A95AB", "token": "markup.quote.markdown" },
    { "foreground": "8A95AB", "token": "punctuation.definition.blockquote.markdown" },
    { "foreground": "7FC8E8", "token": "markup.list.unnumbered.markdown" },
    { "foreground": "7FC8E8", "token": "markup.list.numbered.markdown" },
    { "foreground": "7FC8E8", "token": "beginning.punctuation.definition.list.markdown" },
    { "foreground": "243149", "token": "meta.separator.markdown" },
    { "foreground": "E2C275", "token": "punctuation.definition.string.begin.json - meta.structure.dictionary.value.json" },
    { "foreground": "E2C275", "token": "punctuation.definition.string.end.json - meta.structure.dictionary.value.json" },
    { "foreground": "8A95AB", "token": "meta.structure.dictionary.json string.quoted.double.json" },
    { "foreground": "8FB4F2", "token": "meta.structure.dictionary.value.json string.quoted.double.json" },
    { "foreground": "9AA6BD", "token": "keyword.operator" },
    { "foreground": "6E7B92", "token": "punctuation" }
  ],
  "colors": {
    "editor.foreground": "#E6ECF7",
    "editor.background": "#06080F",
    "editor.selectionBackground": "#5B8DEF33",
    "editor.lineHighlightBackground": "#0C1018",
    "editorCursor.foreground": "#E2C275",
    "editorWhitespace.foreground": "#161B26",
    "editorIndentGuide.activeBackground": "#243149",
    "editor.selectionHighlightBorder": "#5B8DEF33",
    "editorGroupHeader.tabsBackground": "#0D1220",
    "sideBar.background": "#090D18",
    "input.background": "#121A2E",
    "focusBorder": "#E2C275",
    "button.background": "#E2C275",
    "button.foreground": "#0A0E18",
    "panel.border": "#1E2A40",
    "editorGroup.border": "#1E2A40",
    "scrollbarSlider.background": "#E2C27526",
    "descriptionForeground": "#A7B4CC",
    "disabledForeground": "#5E6B82",
    "list.activeSelectionBackground": "#E2C2751F",
    "list.inactiveSelectionBackground": "#E2C27512",
    "list.hoverBackground": "#E2C2750D",
    "tree.indentGuidesStroke": "#1E2A40",
    "statusBar.background": "#0D1220",
    "terminal.background": "#06080F",
    "terminal.foreground": "#E6ECF7",
    "terminalCursor.foreground": "#E2C275",
    "terminalCursor.background": "#06080F",
    "terminal.selectionBackground": "#5B8DEF40",
    "terminal.ansiBlack": "#06080F",
    "terminal.ansiRed": "#D2495F",
    "terminal.ansiGreen": "#43C97A",
    "terminal.ansiYellow": "#E2C275",
    "terminal.ansiBlue": "#3E63C8",
    "terminal.ansiMagenta": "#5B8DEF",
    "terminal.ansiCyan": "#7FC8E8",
    "terminal.ansiWhite": "#D3DBE8",
    "terminal.ansiBrightBlack": "#5E6B82",
    "terminal.ansiBrightRed": "#E26A7E",
    "terminal.ansiBrightGreen": "#5FD993",
    "terminal.ansiBrightYellow": "#F0D693",
    "terminal.ansiBrightBlue": "#5B8DEF",
    "terminal.ansiBrightMagenta": "#8FB4F2",
    "terminal.ansiBrightCyan": "#9BD6EE",
    "terminal.ansiBrightWhite": "#F0F4FB"
  }
}
