{
  "base": "vs",
  "inherit": true,
  "rules": [
    { "background": "FFFFFF", "token": "" },
    { "foreground": "9A8F82", "token": "comment" },
    { "foreground": "9A8F82", "token": "punctuation.definition.comment" },
    { "foreground": "D2491A", "token": "string" },
    { "foreground": "9A7B12", "token": "constant.numeric" },
    { "foreground": "C2410C", "token": "constant.language" },
    { "foreground": "9A7B12", "token": "constant.character" },
    { "foreground": "2D7A45", "token": "constant.other" },
    { "foreground": "2A2620", "token": "variable" },
    { "foreground": "2A2620", "token": "variable.other.readwrite.instance" },
    { "foreground": "C2410C", "fontStyle": "bold", "token": "keyword" },
    { "foreground": "C2410C", "fontStyle": "bold", "token": "storage" },
    { "foreground": "B25A2E", "fontStyle": "italic", "token": "storage.type" },
    { "foreground": "D2491A", "fontStyle": "underline", "token": "entity.name.class" },
    { "foreground": "D2491A", "fontStyle": "italic underline", "token": "entity.other.inherited-class" },
    { "foreground": "1C1A17", "token": "entity.name.function" },
    { "foreground": "2A2620", "fontStyle": "italic", "token": "variable.parameter" },
    { "foreground": "C2410C", "token": "entity.name.tag" },
    { "foreground": "B25A2E", "token": "entity.other.attribute-name" },
    { "foreground": "1C1A17", "token": "support.function" },
    { "foreground": "2D7A45", "token": "support.constant" },
    { "foreground": "B25A2E", "fontStyle": "italic", "token": "support.type" },
    { "foreground": "B25A2E", "fontStyle": "italic", "token": "support.class" },
    { "foreground": "FFFFFF", "background": "A0222F", "token": "invalid" },
    { "foreground": "FFFFFF", "background": "A0481E", "token": "invalid.deprecated" },
    { "foreground": "8A7E6E", "token": "meta.structure.dictionary.json string.quoted.double.json" },
    { "foreground": "9A8F82", "token": "meta.diff" },
    { "foreground": "9A8F82", "token": "meta.diff.header" },
    { "foreground": "A0222F", "token": "markup.deleted" },
    { "foreground": "2D7A45", "token": "markup.inserted" },
    { "foreground": "9A7B12", "token": "markup.changed" },
    { "foreground": "9A7B12", "token": "constant.numeric.line-number.find-in-files - match" },
    { "foreground": "C2410C", "token": "entity.name.filename" },
    { "foreground": "A0222F", "token": "message.error" },
    { "foreground": "C2410C", "fontStyle": "bold", "token": "markup.heading.markdown" },
    { "foreground": "C2410C", "fontStyle": "bold", "token": "markup.heading.1.markdown" },
    { "foreground": "C2410C", "fontStyle": "bold", "token": "markup.heading.2.markdown" },
    { "foreground": "C2410C", "fontStyle": "bold", "token": "markup.heading.3.markdown" },
    { "foreground": "C2410C", "fontStyle": "bold", "token": "markup.heading.4.markdown" },
    { "foreground": "C2410C", "fontStyle": "bold", "token": "markup.heading.5.markdown" },
    { "foreground": "C2410C", "fontStyle": "bold", "token": "markup.heading.6.markdown" },
    { "foreground": "1C1A17", "fontStyle": "bold", "token": "markup.bold.markdown" },
    { "foreground": "B25A2E", "fontStyle": "italic", "token": "markup.italic.markdown" },
    { "foreground": "C2410C", "token": "punctuation.definition.metadata.markdown" },
    { "foreground": "1C1A17", "token": "punctuation.definition.bold.markdown" },
    { "foreground": "B25A2E", "token": "punctuation.definition.italic.markdown" },
    { "foreground": "8A7E6E", "token": "markup.inline.raw.markdown" },
    { "foreground": "8A7E6E", "token": "markup.raw.inline.markdown" },
    { "foreground": "8A7E6E", "token": "markup.raw.block.markdown" },
    { "foreground": "8A7E6E", "token": "punctuation.definition.raw.markdown" },
    { "foreground": "C2410C", "token": "markup.underline.link.markdown" },
    { "foreground": "C2410C", "token": "markup.underline.link.image.markdown" },
    { "foreground": "C2410C", "token": "string.other.link.title.markdown" },
    { "foreground": "1C1A17", "token": "string.other.link.description.markdown" },
    { "foreground": "8A7E6E", "token": "markup.quote.markdown" },
    { "foreground": "8A7E6E", "token": "punctuation.definition.blockquote.markdown" },
    { "foreground": "9A7B12", "token": "markup.list.unnumbered.markdown" },
    { "foreground": "9A7B12", "token": "markup.list.numbered.markdown" },
    { "foreground": "9A7B12", "token": "beginning.punctuation.definition.list.markdown" },
    { "foreground": "D4D4D4", "token": "meta.separator.markdown" },
    { "foreground": "C2410C", "token": "punctuation.definition.string.begin.json - meta.structure.dictionary.value.json" },
    { "foreground": "C2410C", "token": "punctuation.definition.string.end.json - meta.structure.dictionary.value.json" },
    { "foreground": "8A7E6E", "token": "meta.structure.dictionary.json string.quoted.double.json" },
    { "foreground": "D2491A", "token": "meta.structure.dictionary.value.json string.quoted.double.json" },
    { "foreground": "6A6256", "token": "keyword.operator" },
    { "foreground": "9A8F82", "token": "punctuation" }
  ],
  "colors": {
    "editor.foreground": "#1C1A17",
    "editor.background": "#FFFFFF",
    "editor.selectionBackground": "#FF5B2433",
    "editor.lineHighlightBackground": "#F5F5F5",
    "editorCursor.foreground": "#FF5B24",
    "editorWhitespace.foreground": "#DCDCDC",
    "editorIndentGuide.activeBackground": "#C0C0C0",
    "editor.selectionHighlightBorder": "#FF5B2433",
    "editorGroupHeader.tabsBackground": "#ECECEC",
    "sideBar.background": "#F3F3F3",
    "input.background": "#FFFFFF",
    "focusBorder": "#FF5B24",
    "button.background": "#FF5B24",
    "button.foreground": "#FFF4EA",
    "panel.border": "#D4D4D4",
    "editorGroup.border": "#E0E0E0",
    "scrollbarSlider.background": "#C8C8C8",
    "descriptionForeground": "#5C5448",
    "disabledForeground": "#7C715F",
    "list.activeSelectionBackground": "#FF5B2422",
    "list.inactiveSelectionBackground": "#FF5B2414",
    "list.hoverBackground": "#EDEDED",
    "tree.indentGuidesStroke": "#D4D4D4",
    "statusBar.background": "#ECECEC",
    "terminal.background": "#FFFFFF",
    "terminal.foreground": "#1C1A17",
    "terminalCursor.foreground": "#FF5B24",
    "terminalCursor.background": "#FFFFFF",
    "terminal.selectionBackground": "#FF5B2440",
    "terminal.ansiBlack": "#1C1A17",
    "terminal.ansiRed": "#A0222F",
    "terminal.ansiGreen": "#2D7A45",
    "terminal.ansiYellow": "#8A6D00",
    "terminal.ansiBlue": "#2A4475",
    "terminal.ansiMagenta": "#A0481E",
    "terminal.ansiCyan": "#3A6A7A",
    "terminal.ansiWhite": "#5A554C",
    "terminal.ansiBrightBlack": "#9A8F82",
    "terminal.ansiBrightRed": "#C0334D",
    "terminal.ansiBrightGreen": "#38975A",
    "terminal.ansiBrightYellow": "#A07A00",
    "terminal.ansiBrightBlue": "#3A5AA0",
    "terminal.ansiBrightMagenta": "#FF5B24",
    "terminal.ansiBrightCyan": "#4A8090",
    "terminal.ansiBrightWhite": "#2A2620"
  }
}
