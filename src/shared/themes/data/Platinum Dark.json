{
  "base": "vs-dark",
  "inherit": true,
  "rules": [
    { "background": "0A0A0C", "token": "" },
    { "foreground": "5F636C", "token": "comment" },
    { "foreground": "5F636C", "token": "punctuation.definition.comment" },
    { "foreground": "AEB6C2", "token": "string" },
    { "foreground": "C8CDD6", "token": "constant.numeric" },
    { "foreground": "C8CDD6", "token": "constant.language" },
    { "foreground": "C8CDD6", "token": "constant.character" },
    { "foreground": "AEB6C2", "token": "constant.other" },
    { "foreground": "D4D6DC", "token": "variable" },
    { "foreground": "D4D6DC", "token": "variable.other.readwrite.instance" },
    { "foreground": "E8E9ED", "fontStyle": "bold", "token": "keyword" },
    { "foreground": "E8E9ED", "fontStyle": "bold", "token": "storage" },
    { "foreground": "C0C3CB", "fontStyle": "italic", "token": "storage.type" },
    { "foreground": "DEE1E7", "fontStyle": "underline", "token": "entity.name.class" },
    { "foreground": "DEE1E7", "fontStyle": "italic underline", "token": "entity.other.inherited-class" },
    { "foreground": "FFFFFF", "token": "entity.name.function" },
    { "foreground": "D4D6DC", "fontStyle": "italic", "token": "variable.parameter" },
    { "foreground": "C8CDD6", "token": "entity.name.tag" },
    { "foreground": "C0C3CB", "token": "entity.other.attribute-name" },
    { "foreground": "FFFFFF", "token": "support.function" },
    { "foreground": "AEB6C2", "token": "support.constant" },
    { "foreground": "C0C3CB", "fontStyle": "italic", "token": "support.type" },
    { "foreground": "C0C3CB", "fontStyle": "italic", "token": "support.class" },
    { "foreground": "FFFFFF", "background": "C96670", "token": "invalid" },
    { "foreground": "FFFFFF", "background": "5A5E66", "token": "invalid.deprecated" },
    { "foreground": "8A8D95", "token": "meta.structure.dictionary.json string.quoted.double.json" },
    { "foreground": "5F636C", "token": "meta.diff" },
    { "foreground": "5F636C", "token": "meta.diff.header" },
    { "foreground": "C96670", "token": "markup.deleted" },
    { "foreground": "6FBE8E", "token": "markup.inserted" },
    { "foreground": "C9B473", "token": "markup.changed" },
    { "foreground": "C8CDD6", "token": "constant.numeric.line-number.find-in-files - match" },
    { "foreground": "C8CDD6", "token": "entity.name.filename" },
    { "foreground": "C96670", "token": "message.error" },
    { "foreground": "C8CDD6", "fontStyle": "bold", "token": "markup.heading.markdown" },
    { "foreground": "C8CDD6", "fontStyle": "bold", "token": "markup.heading.1.markdown" },
    { "foreground": "C8CDD6", "fontStyle": "bold", "token": "markup.heading.2.markdown" },
    { "foreground": "C8CDD6", "fontStyle": "bold", "token": "markup.heading.3.markdown" },
    { "foreground": "C8CDD6", "fontStyle": "bold", "token": "markup.heading.4.markdown" },
    { "foreground": "C8CDD6", "fontStyle": "bold", "token": "markup.heading.5.markdown" },
    { "foreground": "C8CDD6", "fontStyle": "bold", "token": "markup.heading.6.markdown" },
    { "foreground": "FFFFFF", "fontStyle": "bold", "token": "markup.bold.markdown" },
    { "foreground": "C0C3CB", "fontStyle": "italic", "token": "markup.italic.markdown" },
    { "foreground": "C8CDD6", "token": "punctuation.definition.metadata.markdown" },
    { "foreground": "FFFFFF", "token": "punctuation.definition.bold.markdown" },
    { "foreground": "C0C3CB", "token": "punctuation.definition.italic.markdown" },
    { "foreground": "8A8D95", "token": "markup.inline.raw.markdown" },
    { "foreground": "8A8D95", "token": "markup.raw.inline.markdown" },
    { "foreground": "8A8D95", "token": "markup.raw.block.markdown" },
    { "foreground": "8A8D95", "token": "punctuation.definition.raw.markdown" },
    { "foreground": "C8CDD6", "token": "markup.underline.link.markdown" },
    { "foreground": "C8CDD6", "token": "markup.underline.link.image.markdown" },
    { "foreground": "C8CDD6", "token": "string.other.link.title.markdown" },
    { "foreground": "FFFFFF", "token": "string.other.link.description.markdown" },
    { "foreground": "8A8D95", "token": "markup.quote.markdown" },
    { "foreground": "8A8D95", "token": "punctuation.definition.blockquote.markdown" },
    { "foreground": "C8CDD6", "token": "markup.list.unnumbered.markdown" },
    { "foreground": "C8CDD6", "token": "markup.list.numbered.markdown" },
    { "foreground": "C8CDD6", "token": "beginning.punctuation.definition.list.markdown" },
    { "foreground": "2E3036", "token": "meta.separator.markdown" },
    { "foreground": "C8CDD6", "token": "punctuation.definition.string.begin.json - meta.structure.dictionary.value.json" },
    { "foreground": "C8CDD6", "token": "punctuation.definition.string.end.json - meta.structure.dictionary.value.json" },
    { "foreground": "8A8D95", "token": "meta.structure.dictionary.json string.quoted.double.json" },
    { "foreground": "AEB6C2", "token": "meta.structure.dictionary.value.json string.quoted.double.json" },
    { "foreground": "9A9DA6", "token": "keyword.operator" },
    { "foreground": "5F636C", "token": "punctuation" }
  ],
  "colors": {
    "editor.foreground": "#E8E9ED",
    "editor.background": "#0A0A0C",
    "editor.selectionBackground": "#C8CDD633",
    "editor.lineHighlightBackground": "#101013",
    "editorCursor.foreground": "#C8CDD6",
    "editorWhitespace.foreground": "#1A1B1F",
    "editorIndentGuide.activeBackground": "#2E3036",
    "editor.selectionHighlightBorder": "#C8CDD633",
    "editorGroupHeader.tabsBackground": "#141416",
    "sideBar.background": "#08080A",
    "input.background": "#101013",
    "focusBorder": "#C8CDD6",
    "button.background": "#C8CDD6",
    "button.foreground": "#0A0A0C",
    "panel.border": "#222328",
    "editorGroup.border": "#222328",
    "scrollbarSlider.background": "#C8CDD626",
    "descriptionForeground": "#A9ACB4",
    "disabledForeground": "#5F636C",
    "list.activeSelectionBackground": "#C8CDD61A",
    "list.inactiveSelectionBackground": "#C8CDD610",
    "list.hoverBackground": "#C8CDD60D",
    "tree.indentGuidesStroke": "#222328",
    "statusBar.background": "#141416",
    "terminal.background": "#0A0A0C",
    "terminal.foreground": "#E8E9ED",
    "terminalCursor.foreground": "#C8CDD6",
    "terminalCursor.background": "#0A0A0C",
    "terminal.selectionBackground": "#C8CDD640",
    "terminal.ansiBlack": "#0A0A0C",
    "terminal.ansiRed": "#C96670",
    "terminal.ansiGreen": "#6FBE8E",
    "terminal.ansiYellow": "#C9B473",
    "terminal.ansiBlue": "#7C9DC9",
    "terminal.ansiMagenta": "#A98FC9",
    "terminal.ansiCyan": "#4AC9C9",
    "terminal.ansiWhite": "#E8E9ED",
    "terminal.ansiBrightBlack": "#5F636C",
    "terminal.ansiBrightRed": "#DB8490",
    "terminal.ansiBrightGreen": "#8DD3A8",
    "terminal.ansiBrightYellow": "#DCCB90",
    "terminal.ansiBrightBlue": "#9AB8DE",
    "terminal.ansiBrightMagenta": "#C2ABDE",
    "terminal.ansiBrightCyan": "#6FDADA",
    "terminal.ansiBrightWhite": "#FFFFFF"
  }
}
