    { "foreground": "3A4150", "fontStyle": "bold", "token": "markup.heading.1.markdown" },
    { "foreground": "3A4150", "fontStyle": "bold", "token": "markup.heading.2.markdown" },
    { "foreground": "3A4150", "fontStyle": "bold", "token": "markup.heading.3.markdown" },
    { "foreground": "3A4150", "fontStyle": "bold", "token": "markup.heading.4.markdown" },
    { "foreground": "3A4150", "fontStyle": "bold", "token": "markup.heading.5.markdown" },
    { "foreground": "3A4150", "fontStyle": "bold", "token": "markup.heading.6.markdown" },
    { "foreground": "0E0F12", "fontStyle": "bold", "token": "markup.bold.markdown" },
    { "foreground": "4A4F5A", "fontStyle": "italic", "token": "markup.italic.markdown" },
    { "foreground": "3A4150", "token": "punctuation.definition.metadata.markdown" },
    { "foreground": "0E0F12", "token": "punctuation.definition.bold.markdown" },
    { "foreground": "4A4F5A", "token": "punctuation.definition.italic.markdown" },
    { "foreground": "8A8D95", "token": "markup.inline.raw.markdown" },
    { "foreground": "8A8D95", "token": "markup.raw.inline.markdown" },
    { "foreground": "8A8D95", "token": "markup.raw.block.markdown" },
    { "foreground": "8A8D95", "token": "punctuation.definition.raw.markdown" },
    { "foreground": "3A4150", "token": "markup.underline.link.markdown" },
    { "foreground": "3A4150", "token": "markup.underline.link.image.markdown" },
