    { "foreground": "565E6E", "token": "support.constant" },
    { "foreground": "4A4F5A", "fontStyle": "italic", "token": "support.type" },
    { "foreground": "4A4F5A", "fontStyle": "italic", "token": "support.class" },
    { "foreground": "FAFAFB", "background": "B5454F", "token": "invalid" },
    { "foreground": "FAFAFB", "background": "6E7280", "token": "invalid.deprecated" },
    { "foreground": "8A8D95", "token": "meta.structure.dictionary.json string.quoted.double.json" },
