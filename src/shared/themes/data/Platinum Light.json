    { "foreground": "8A8D95", "token": "punctuation.definition.blockquote.markdown" },
    { "foreground": "3A4150", "token": "markup.list.unnumbered.markdown" },
    { "foreground": "3A4150", "token": "markup.list.numbered.markdown" },
    { "foreground": "3A4150", "token": "beginning.punctuation.definition.list.markdown" },
    { "foreground": "DCDDE1", "token": "meta.separator.markdown" },
    { "foreground": "3A4150", "token": "punctuation.definition.string.begin.json - meta.structure.dictionary.value.json" },
    { "foreground": "3A4150", "token": "punctuation.definition.string.end.json - meta.structure.dictionary.value.json" },
    { "foreground": "8A8D95", "token": "meta.structure.dictionary.json string.quoted.double.json" },
    { "foreground": "565E6E", "token": "meta.structure.dictionary.value.json string.quoted.double.json" },
    { "foreground": "5C6068", "token": "keyword.operator" },
    { "foreground": "9A9DA6", "token": "punctuation" }
