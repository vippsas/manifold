    { "foreground": "565E6E", "token": "string" },
    { "foreground": "3A4150", "token": "constant.numeric" },
    { "foreground": "3A4150", "token": "constant.language" },
    { "foreground": "3A4150", "token": "constant.character" },
    { "foreground": "565E6E", "token": "constant.other" },
    { "foreground": "32353D", "token": "variable" },
    { "foreground": "32353D", "token": "variable.other.readwrite.instance" },
    { "foreground": "25272D", "fontStyle": "bold", "token": "keyword" },
    { "foreground": "25272D", "fontStyle": "bold", "token": "storage" },
    { "foreground": "4A4F5A", "fontStyle": "italic", "token": "storage.type" },
    { "foreground": "3C434F", "fontStyle": "underline", "token": "entity.name.class" },
    { "foreground": "3C434F", "fontStyle": "italic underline", "token": "entity.other.inherited-class" },
    { "foreground": "0E0F12", "token": "entity.name.function" },
    { "foreground": "32353D", "fontStyle": "italic", "token": "variable.parameter" },
