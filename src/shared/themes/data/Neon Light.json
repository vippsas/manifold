{
  "base": "vs",
  "inherit": true,
  "rules": [
    { "background": "FDFDFB", "token": "" },
    { "foreground": "8E897F", "token": "comment" },
    { "foreground": "8E897F", "token": "punctuation.definition.comment" },
    { "foreground": "0E8C8C", "token": "string" },
    { "foreground": "7C3AED", "token": "constant.numeric" },
    { "foreground": "C00069", "token": "constant.language" },
    { "foreground": "7C3AED", "token": "constant.character" },
    { "foreground": "197A4B", "token": "constant.other" },
    { "foreground": "2A2620", "token": "variable" },
    { "foreground": "2A2620", "token": "variable.other.readwrite.instance" },
    { "foreground": "C00069", "fontStyle": "bold", "token": "keyword" },
    { "foreground": "C00069", "fontStyle": "bold", "token": "storage" },
    { "foreground": "9A4FB0", "fontStyle": "italic", "token": "storage.type" },
    { "foreground": "0E8C8C", "fontStyle": "underline", "token": "entity.name.class" },
    { "foreground": "0E8C8C", "fontStyle": "italic underline", "token": "entity.other.inherited-class" },
    { "foreground": "1A1410", "token": "entity.name.function" },
    { "foreground": "2A2620", "fontStyle": "italic", "token": "variable.parameter" },
    { "foreground": "C00069", "token": "entity.name.tag" },
    { "foreground": "9A4FB0", "token": "entity.other.attribute-name" },
    { "foreground": "1A1410", "token": "support.function" },
    { "foreground": "7C3AED", "token": "support.constant" },
    { "foreground": "9A4FB0", "fontStyle": "italic", "token": "support.type" },
    { "foreground": "9A4FB0", "fontStyle": "italic", "token": "support.class" },
    { "foreground": "FFFFFF", "background": "A0222F", "token": "invalid" },
    { "foreground": "FFFFFF", "background": "7A2A5A", "token": "invalid.deprecated" },
    { "foreground": "8E897F", "token": "meta.structure.dictionary.json string.quoted.double.json" },
    { "foreground": "8E897F", "token": "meta.diff" },
    { "foreground": "8E897F", "token": "meta.diff.header" },
    { "foreground": "C0334D", "token": "markup.deleted" },
    { "foreground": "197A4B", "token": "markup.inserted" },
    { "foreground": "7C3AED", "token": "markup.changed" },
    { "foreground": "7C3AED", "token": "constant.numeric.line-number.find-in-files - match" },
    { "foreground": "C00069", "token": "entity.name.filename" },
    { "foreground": "C0334D", "token": "message.error" },
    { "foreground": "C00069", "fontStyle": "bold", "token": "markup.heading.markdown" },
    { "foreground": "C00069", "fontStyle": "bold", "token": "markup.heading.1.markdown" },
    { "foreground": "C00069", "fontStyle": "bold", "token": "markup.heading.2.markdown" },
    { "foreground": "C00069", "fontStyle": "bold", "token": "markup.heading.3.markdown" },
    { "foreground": "C00069", "fontStyle": "bold", "token": "markup.heading.4.markdown" },
    { "foreground": "C00069", "fontStyle": "bold", "token": "markup.heading.5.markdown" },
    { "foreground": "C00069", "fontStyle": "bold", "token": "markup.heading.6.markdown" },
    { "foreground": "1A1410", "fontStyle": "bold", "token": "markup.bold.markdown" },
    { "foreground": "9A4FB0", "fontStyle": "italic", "token": "markup.italic.markdown" },
    { "foreground": "C00069", "token": "punctuation.definition.metadata.markdown" },
    { "foreground": "1A1410", "token": "punctuation.definition.bold.markdown" },
    { "foreground": "9A4FB0", "token": "punctuation.definition.italic.markdown" },
    { "foreground": "8E897F", "token": "markup.inline.raw.markdown" },
    { "foreground": "8E897F", "token": "markup.raw.inline.markdown" },
    { "foreground": "8E897F", "token": "markup.raw.block.markdown" },
    { "foreground": "8E897F", "token": "punctuation.definition.raw.markdown" },
    { "foreground": "C00069", "token": "markup.underline.link.markdown" },
    { "foreground": "C00069", "token": "markup.underline.link.image.markdown" },
    { "foreground": "C00069", "token": "string.other.link.title.markdown" },
    { "foreground": "1A1410", "token": "string.other.link.description.markdown" },
    { "foreground": "8E897F", "token": "markup.quote.markdown" },
    { "foreground": "8E897F", "token": "punctuation.definition.blockquote.markdown" },
    { "foreground": "7C3AED", "token": "markup.list.unnumbered.markdown" },
    { "foreground": "7C3AED", "token": "markup.list.numbered.markdown" },
    { "foreground": "7C3AED", "token": "beginning.punctuation.definition.list.markdown" },
    { "foreground": "E2E2DD", "token": "meta.separator.markdown" },
    { "foreground": "C00069", "token": "punctuation.definition.string.begin.json - meta.structure.dictionary.value.json" },
    { "foreground": "C00069", "token": "punctuation.definition.string.end.json - meta.structure.dictionary.value.json" },
    { "foreground": "8E897F", "token": "meta.structure.dictionary.json string.quoted.double.json" },
    { "foreground": "0E8C8C", "token": "meta.structure.dictionary.value.json string.quoted.double.json" },
    { "foreground": "6A6256", "token": "keyword.operator" },
    { "foreground": "8E897F", "token": "punctuation" }
  ],
  "colors": {
