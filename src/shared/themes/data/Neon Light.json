    "terminal.ansiWhite": "#5A554C",
    "terminal.ansiBrightBlack": "#8E897F",
    "terminal.ansiBrightRed": "#E0506E",
    "terminal.ansiBrightGreen": "#23985E",
    "terminal.ansiBrightYellow": "#A07A00",
    "terminal.ansiBrightBlue": "#7C3AED",
