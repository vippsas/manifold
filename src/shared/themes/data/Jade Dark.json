{
  "base": "vs-dark",
  "inherit": true,
  "rules": [
    { "background": "080C0A", "token": "" },
    { "foreground": "647A6E", "token": "comment" },
    { "foreground": "647A6E", "token": "punctuation.definition.comment" },
    { "foreground": "8FD9BC", "token": "string" },
    { "foreground": "E6B422", "token": "constant.numeric" },
    { "foreground": "5FBF9A", "token": "constant.language" },
    { "foreground": "E6B422", "token": "constant.character" },
    { "foreground": "2D8B4E", "token": "constant.other" },
    { "foreground": "D5E3DB", "token": "variable" },
    { "foreground": "D5E3DB", "token": "variable.other.readwrite.instance" },
    { "foreground": "5FBF9A", "fontStyle": "bold", "token": "keyword" },
    { "foreground": "5FBF9A", "fontStyle": "bold", "token": "storage" },
    { "foreground": "BFC9C4", "fontStyle": "italic", "token": "storage.type" },
    { "foreground": "8FD9BC", "fontStyle": "underline", "token": "entity.name.class" },
    { "foreground": "8FD9BC", "fontStyle": "italic underline", "token": "entity.other.inherited-class" },
    { "foreground": "F0F7F3", "token": "entity.name.function" },
    { "foreground": "D5E3DB", "fontStyle": "italic", "token": "variable.parameter" },
    { "foreground": "5FBF9A", "token": "entity.name.tag" },
    { "foreground": "BFC9C4", "token": "entity.other.attribute-name" },
    { "foreground": "F0F7F3", "token": "support.function" },
    { "foreground": "2D8B4E", "token": "support.constant" },
    { "foreground": "BFC9C4", "fontStyle": "italic", "token": "support.type" },
    { "foreground": "BFC9C4", "fontStyle": "italic", "token": "support.class" },
    { "foreground": "F0F7F3", "background": "A0222F", "token": "invalid" },
    { "foreground": "F0F7F3", "background": "3E6B58", "token": "invalid.deprecated" },
    { "foreground": "84988C", "token": "meta.structure.dictionary.json string.quoted.double.json" },
    { "foreground": "647A6E", "token": "meta.diff" },
    { "foreground": "647A6E", "token": "meta.diff.header" },
    { "foreground": "A0222F", "token": "markup.deleted" },
    { "foreground": "2D8B4E", "token": "markup.inserted" },
    { "foreground": "E6B422", "token": "markup.changed" },
    { "foreground": "E6B422", "token": "constant.numeric.line-number.find-in-files - match" },
    { "foreground": "5FBF9A", "token": "entity.name.filename" },
    { "foreground": "A0222F", "token": "message.error" },
    { "foreground": "5FBF9A", "fontStyle": "bold", "token": "markup.heading.markdown" },
    { "foreground": "5FBF9A", "fontStyle": "bold", "token": "markup.heading.1.markdown" },
    { "foreground": "5FBF9A", "fontStyle": "bold", "token": "markup.heading.2.markdown" },
    { "foreground": "5FBF9A", "fontStyle": "bold", "token": "markup.heading.3.markdown" },
    { "foreground": "5FBF9A", "fontStyle": "bold", "token": "markup.heading.4.markdown" },
    { "foreground": "5FBF9A", "fontStyle": "bold", "token": "markup.heading.5.markdown" },
    { "foreground": "5FBF9A", "fontStyle": "bold", "token": "markup.heading.6.markdown" },
    { "foreground": "F0F7F3", "fontStyle": "bold", "token": "markup.bold.markdown" },
    { "foreground": "BFC9C4", "fontStyle": "italic", "token": "markup.italic.markdown" },
    { "foreground": "5FBF9A", "token": "punctuation.definition.metadata.markdown" },
    { "foreground": "F0F7F3", "token": "punctuation.definition.bold.markdown" },
    { "foreground": "BFC9C4", "token": "punctuation.definition.italic.markdown" },
    { "foreground": "84988C", "token": "markup.inline.raw.markdown" },
    { "foreground": "84988C", "token": "markup.raw.inline.markdown" },
    { "foreground": "84988C", "token": "markup.raw.block.markdown" },
    { "foreground": "84988C", "token": "punctuation.definition.raw.markdown" },
    { "foreground": "5FBF9A", "token": "markup.underline.link.markdown" },
    { "foreground": "5FBF9A", "token": "markup.underline.link.image.markdown" },
    { "foreground": "5FBF9A", "token": "string.other.link.title.markdown" },
    { "foreground": "F0F7F3", "token": "string.other.link.description.markdown" },
    { "foreground": "84988C", "token": "markup.quote.markdown" },
    { "foreground": "84988C", "token": "punctuation.definition.blockquote.markdown" },
    { "foreground": "E6B422", "token": "markup.list.unnumbered.markdown" },
    { "foreground": "E6B422", "token": "markup.list.numbered.markdown" },
    { "foreground": "E6B422", "token": "beginning.punctuation.definition.list.markdown" },
    { "foreground": "2A3A30", "token": "meta.separator.markdown" },
    { "foreground": "5FBF9A", "token": "punctuation.definition.string.begin.json - meta.structure.dictionary.value.json" },
    { "foreground": "5FBF9A", "token": "punctuation.definition.string.end.json - meta.structure.dictionary.value.json" },
    { "foreground": "84988C", "token": "meta.structure.dictionary.json string.quoted.double.json" },
    { "foreground": "8FD9BC", "token": "meta.structure.dictionary.value.json string.quoted.double.json" },
    { "foreground": "9AAAA0", "token": "keyword.operator" },
    { "foreground": "647A6E", "token": "punctuation" }
  ],
  "colors": {
    "editor.foreground": "#E6F0EA",
    "editor.background": "#080C0A",
    "editor.selectionBackground": "#5FBF9A33",
    "editor.lineHighlightBackground": "#0C120E",
    "editorCursor.foreground": "#5FBF9A",
    "editorWhitespace.foreground": "#16201A",
    "editorIndentGuide.activeBackground": "#24382E",
    "editor.selectionHighlightBorder": "#5FBF9A33",
    "editorGroupHeader.tabsBackground": "#101713",
    "sideBar.background": "#060A08",
    "input.background": "#0E1713",
    "focusBorder": "#5FBF9A",
    "button.background": "#5FBF9A",
    "button.foreground": "#07120D",
    "panel.border": "#1C2922",
    "editorGroup.border": "#1C2922",
    "scrollbarSlider.background": "#5FBF9A26",
    "descriptionForeground": "#A9BFB3",
    "disabledForeground": "#647A6E",
    "list.activeSelectionBackground": "#5FBF9A1F",
    "list.inactiveSelectionBackground": "#5FBF9A12",
    "list.hoverBackground": "#5FBF9A0D",
    "tree.indentGuidesStroke": "#1C2922",
    "statusBar.background": "#101713",
    "terminal.background": "#080C0A",
    "terminal.foreground": "#E6F0EA",
    "terminalCursor.foreground": "#5FBF9A",
    "terminalCursor.background": "#080C0A",
    "terminal.selectionBackground": "#5FBF9A40",
    "terminal.ansiBlack": "#080C0A",
    "terminal.ansiRed": "#D2495F",
    "terminal.ansiGreen": "#43C97A",
    "terminal.ansiYellow": "#E6B422",
    "terminal.ansiBlue": "#3E7BC8",
    "terminal.ansiMagenta": "#9C7BD8",
    "terminal.ansiCyan": "#4FB8D9",
    "terminal.ansiWhite": "#D5E3DB",
    "terminal.ansiBrightBlack": "#647A6E",
    "terminal.ansiBrightRed": "#E26A7E",
    "terminal.ansiBrightGreen": "#5FD993",
    "terminal.ansiBrightYellow": "#F0D693",
    "terminal.ansiBrightBlue": "#6FA3E0",
    "terminal.ansiBrightMagenta": "#B59AE6",
    "terminal.ansiBrightCyan": "#7FD0E8",
    "terminal.ansiBrightWhite": "#F0F7F3"
  }
}
