{
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2021",
    "lib": ["ES2021"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": { "manifold": ["./src/shared/plugins/manifold-module.d.ts"] }
  },
  "include": [
    "resources/plugins/*/src/**/*.ts",
    "src/shared/plugins/manifold-module.d.ts",
    "src/shared/plugins/api-types.ts"
  ]
}
